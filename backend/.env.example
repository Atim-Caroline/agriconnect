# -------------------------------------------------------
# AgriConnect Backend — Environment Variables
# Copy this file to .env and fill in your values.
# -------------------------------------------------------

# Django secret key (change in production!)
SECRET_KEY=your-secret-key-here

# Set to 0 for production
DEBUG=1

# Supabase PostgreSQL connection URI (not the https://<project>.supabase.co API URL).
# Copy the Transaction pooler URI (usually port 6543) from Supabase Dashboard → Connect.
SUPABASE_DB_URL=

# Optional node label for health checks/logs.
AGRI_NODE_ID=

# Optional sync worker settings.
SYNC_PEERS=
SYNC_TOKEN=
